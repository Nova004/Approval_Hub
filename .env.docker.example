# ==========================================
# Approval Hub - Docker Environment Variables
# ==========================================
# คัดลอกไฟล์นี้เป็น .env ก่อนสั่ง docker compose up

# Database Configuration (SQL Server 192.168.1.237)
DB_SERVER=192.168.1.237
DB_DATABASE=AGT_SMART_SY
DB_USER=sa
DB_PASSWORD=your_sql_password_here
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Port Mapping บน Host Server
BACKEND_PORT=3002
FRONTEND_PORT=81

